{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "allowJs": true,
    "checkJs": false, // set to true if you want TS to type-check JS files
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@assets": ["./src/assets"],
      "@context": ["./src/context"],
      "@utils": ["./src/utils"],
      "@hooks": ["./src/hooks"],
      "@components": ["./src/components"],
      "@pages": ["./src/pages"],
      "@shared": ["../shared"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
